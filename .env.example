# Local development / testing only. Railway deployments get these from the template.

# Required by Receipt Wrangler
ENCRYPTION_KEY=replace-with-a-long-random-string
SECRET_KEY=replace-with-a-long-random-string

# Database (PostgreSQL)
DB_ENGINE=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_USER=wrangler
DB_PASSWORD=change-me-locally
DB_NAME=wrangler

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-locally

# Wrapper: replaces upstream's default admin/admin password before the app is exposed
RW_ADMIN_USERNAME=admin
RW_ADMIN_PASSWORD=replace-with-a-long-random-password
APP_READY_TIMEOUT=300
